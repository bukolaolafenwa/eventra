{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-payouts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-daily-sales-summary",
      "schedule": "0 6 * * *"
    }
  ]
}